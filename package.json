{
  "name": "slug-pages",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "generate-routes": "tsr generate",
    "check": "biome check",
    "format": "biome format",
    "lint": "biome lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply slug-pages-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply slug-pages-db --remote"
  },
  "dependencies": {
    "@tanstack/markdown": "^0.0.13",
    "@tanstack/react-devtools": "^0.10.15",
    "@tanstack/react-pacer": "^0.24.1",
    "@tanstack/react-pacer-devtools": "^0.9.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.4",
    "@tanstack/react-start": "^1.169.7",
    "drizzle-orm": "^0.45.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@cloudflare/vite-plugin": "^1.70.1",
    "@tanstack/devtools-vite": "^0.8.7",
    "@tanstack/router-cli": "^1.168.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "intent": {
    "skills": [
      "@tanstack/*"
    ]
  }
}
